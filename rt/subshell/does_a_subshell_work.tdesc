-- -*- lua -*-
testdescript = {
   owner   = "rtm",
   product = "Lmod Test Suite",
   description = [[
	 Does a subshell work?
   ]],
   keywords = {"subshell","normal","all" },

   active = true,
   testName = "does_a_subshell_work",
   job_submit_method = "INTERACTIVE",

   runScript = [[

     . $(projectDir)/rt/common_funcs.sh

     echo PATH: $PATH

     init
     export MODULEPATH_ROOT=$testDir/mf
     export MODULEPATH=$MODULEPATH_ROOT/Core

cat > $testName.sh << 'EOF'
#!/bin/bash -l
     set -u
     unset LMOD_RTM_TESTING
     $(projectDir)/tools/version_cmd
     module --version
     export LMOD_SYSTEM_DEFAULT_MODULES=B
     module load A B
     module list
     alias  | grep a_func 1>&2
     echo A: $A 1>&2
     ./subshell.sh
EOF

cat > subshell.sh << 'EOF'
#!/bin/bash -l
     module --version
     module list
     echo A: $A 1>&2
     alias | grep a_func 1>&2
EOF

cat > tryThis.sh << 'EOF'
#!/bin/bash
     echo BASH_ENV: %$BASH_ENV% 1>&2
     module purge
     clearMT
     export MODULEPATH_ROOT=$testDir/mf
     export MODULEPATH=$MODULEPATH_ROOT/Core
     unset LMOD_RTM_TESTING
     echo "In tryThis.sh" 1>&2
     export LD_LIBRARY_PATH="/def/abc:/qrtst/def"
     module load A
     module load prependLibPath
     module list 
     echo LD_LIBRARY_PATH=%$LD_LIBRARY_PATH% 1>&2
     echo "Leaving tryThis.sh" 1>&2
EOF

cat > tryThis.csh << 'EOF'
#!/bin/tcsh
     unsetenv LMOD_RTM_TESTING
     rm -f LDD_result.log
     module purge
     clearMT
     setenv LD_LIBRARY_PATH /def/abc:/qrtst/def
     setenv MODULEPATH_ROOT $(testDir)/mf
     setenv MODULEPATH $MODULEPATH_ROOT/Core
     echo "old -> LD_LIBRARY_PATH=%$LD_LIBRARY_PATH%" >> LDD_result.log
     module load A
     module load prependLibPath
     module list 
     echo "new -> LD_LIBRARY_PATH=%$LD_LIBRARY_PATH%" >> LDD_result.log
EOF

     chmod +x $testName.sh subshell.sh tryThis.sh tryThis.csh
     ./$testName.sh 2> _stderr.orig

     echo "Before"  2>> _stderr.orig 1>&2
     unset BASH_ENV
     ./tryThis.sh   2>> _stderr.orig
     echo "After"   2>> _stderr.orig 1>&2

     echo "Before csh"  2>> _stderr.orig 1>&2
     ./tryThis.csh      2>> _stderr.orig
     cat LDD_result.log 2>> _stderr.orig 1>&2
     echo "After csh"   2>> _stderr.orig 1>&2

     HOME=$ORIG_HOME

     cleanUp _stderr.orig err.txt
     rm -f results.csv
     wrapperDiff --csv results.csv $(testDir)/err.txt err.txt
     testFinish -r $(resultFn) -t $(runtimeFn) results.csv
   ]],


   blessScript = [[
         # perform what is needed
   ]],

   tests = {
      { id='t1'},
   },

}
